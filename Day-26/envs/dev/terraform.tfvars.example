# Example dev values (safe to commit)
# Copy to terraform.tfvars if you want to run locally.

app_name    = "web-challenge-day26"
environment = "dev"

# Amazon Linux 2023 in us-east-1 (example)
ami_id = "ami-0c02fb55956c7d316"

instance_type = "t3.micro"
key_name      = null

# Leave vpc_id and subnet IDs empty to auto-discover the default VPC and subnets.
vpc_id            = ""
public_subnet_ids = []

# Exclude any AZs that don't support your chosen instance type in your account.
excluded_availability_zones = ["us-east-1e"]

min_size         = 1
max_size         = 4
desired_capacity = 2

cpu_scale_out_threshold      = 70
cpu_scale_in_threshold       = 30
high_request_count_threshold = 1000
