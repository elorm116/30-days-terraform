# sentinel/require-instance-type.sentinel
#
# POLICY: Allowed Instance Types (All Workspaces)
#
# Prevents any aws_instance or aws_launch_template from using an instance type
# outside the approved list. This is a cost and security control — it stops
# engineers from accidentally provisioning expensive or non-standard instance
# families that aren't covered by organisational Reserved Instance purchases.
#
# Enforcement level: hard-mandatory
# Applies to: all workspaces (dev, staging, prod)
#
# To use a different instance type:
#   1. Open a PR updating this policy
#   2. Have a platform engineer approve it
#   3. Update the relevant tfvars file
#   — this creates an auditable change record for every instance type exception
#
# What this BLOCKS:
#   - m5.xlarge, c5.2xlarge, r5.4xlarge, p3.8xlarge, and all other non-t2/t3 types
#   - t4g (Graviton) — not on approved list, add when tested for compatibility
#
# What this ALLOWS:
#   - t2.micro, t2.small, t2.medium
#   - t3.micro, t3.small, t3.medium

import "tfplan/v2" as tfplan

# ── Approved instance types ───────────────────────────────────────────────────
allowed_instance_types = [
  "t2.micro",
  "t2.small",
  "t2.medium",
  "t3.micro",
  "t3.small",
  "t3.medium",
]

# ── Helper: extract instance type from a resource change ─────────────────────
get_instance_type = func(rc) {
  if rc.type is "aws_instance" {
    return rc.change.after.instance_type else null
  }
  if rc.type is "aws_launch_template" {
    return rc.change.after.instance_type else null
  }
  return null
}

# ── Rule: every compute resource must use an approved instance type ───────────
instance_type_approved = rule {
  all tfplan.resource_changes as _, rc {
    rc.mode is "managed" and
    (rc.type is "aws_instance" or rc.type is "aws_launch_template") and
    rc.change.actions is not ["delete"]
  } implies {
    instance_type = get_instance_type(rc)
    instance_type is not null and instance_type in allowed_instance_types
  }
}

main = rule {
  instance_type_approved
}
